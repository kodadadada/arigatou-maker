{
  "name": "arigatou-maker",
  "productName": "ArigatouMaker",
  "version": "1.0.0",
  "description": "チャンネル登録・スパチャ・メンバー・ジュエルのお礼モーションを作るツール",
  "author": "kodadadada",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.kodadadada.arigatou-maker",
    "productName": "ArigatouMaker",
    "artifactName": "arigatou-maker-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "template.json",
      "manifest.webmanifest",
      "icons/**",
      "!build/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSHasLocalizedDisplayName": true
      },
      "extraResources": [
        {
          "from": "build/ja.lproj",
          "to": "ja.lproj"
        }
      ]
    },
    "dmg": {
      "title": "ありがとう演出メーカー"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ありがとう演出メーカー",
      "uninstallDisplayName": "ありがとう演出メーカー"
    }
  }
}
